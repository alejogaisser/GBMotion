# Copiá este archivo como .env.local y descomentá lo que uses.
# Después de editar .env.local hay que reiniciar GB Motion.
# Las claves las lee sólo el servidor local: nunca llegan al navegador.

# Subtítulos automáticos con ElevenLabs Scribe v2 (recomendado)
# ELEVENLABS_API_KEY=

# Alternativa: Groq Whisper large-v3
# GROQ_API_KEY=

# Servicio a usar si hay más de una clave: elevenlabs o groq.
# Si no se define, se usa el primero que tenga clave (ElevenLabs primero).
# GB_TRANSCRIBE_PROVIDER=elevenlabs

# Carpeta donde se guardan los videos que subís.
# Por defecto: %LOCALAPPDATA%\gb-motion\media (fuera de OneDrive).
# GB_MEDIA_DIR=

# Probar todo sin pagar: usa una transcripción de ejemplo en vez de llamar a la IA.
# GB_TRANSCRIBE_MOCK=1
